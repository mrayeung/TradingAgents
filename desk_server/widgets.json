  "portfolio_weights": {
    "name": "Portfolio Weights (BL)",
    "description": "Black-Litterman optimised portfolio weights for a given ticker set. Adjust risk aversion and position bounds to explore allocation scenarios.",
    "category": "Portfolio",
    "searchCategory": "Portfolio",
    "endpoint": "/portfolio/weights",
    "gridData": {
      "w": 20,
      "h": 9
    },
    "params": [
      {
        "paramName": "tickers",
        "label": "Tickers",
        "description": "Comma-separated list of tickers to optimise (e.g. AAPL,MSFT,NVDA)",
        "value": "",
        "type": "text",
        "show": true,
        "optional": false
      },
      {
        "paramName": "risk_aversion",
        "label": "Risk Aversion",
        "description": "Higher values penalise volatility more heavily (default: 2.5)",
        "value": "2.5",
        "type": "number",
        "show": true,
        "optional": true
      },
      {
        "paramName": "max_position",
        "label": "Max Position",
        "description": "Maximum weight for any single position (default: 0.40)",
        "value": "0.40",
        "type": "number",
        "show": true,
        "optional": true
      },
      {
        "paramName": "min_position",
        "label": "Min Position",
        "description": "Minimum weight for any single position (default: 0.02)",
        "value": "0.02",
        "type": "number",
        "show": true,
        "optional": true
      },
      {
        "paramName": "lookback_days",
        "label": "Lookback (days)",
        "description": "Historical window used to estimate covariance (default: 90)",
        "value": "90",
        "type": "number",
        "show": true,
        "optional": true
      }
    ],
    "data": {
      "dataKey": "weights",
